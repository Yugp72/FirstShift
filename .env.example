# mock = zero network calls (default, judge deploy). live = call Converge.AI through backend/ai/.
FS_MODE=mock
FS_PROVIDER=converge
# Hard cap on live AI calls per process (see plan section 4.4).
FS_LIVE_BUDGET=50
# Live mode only. VERIFY: see backend/ai/CONVERGE_NOTES.md
CONVERGE_API_URL=
CONVERGE_API_KEY=
# Public base URL used in hire links + QR codes (e.g. your LAN IP for phone testing, or the deploy URL).
FS_PUBLIC_URL=
# Optional: SQLite path
# FS_DB=data/firstshift.db
